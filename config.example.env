# Copy to .env. Keep .env private. Node 24 is required.
PORT=3000
# Use 0.0.0.0 for LAN access; use an HTTPS reverse proxy for internet access.
HOST=127.0.0.1
DATA_DIR=./data
# Set to your public HTTPS origin when using a reverse proxy:
# PUBLIC_ORIGIN=https://shop.example.com
# Optional first-time administrator setup code (minimum 32 characters).
# Otherwise a unique code is generated in data/setup-token.txt.
# SETUP_TOKEN=
