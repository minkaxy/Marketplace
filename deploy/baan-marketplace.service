[Unit]
Description=BAAN Marketplace
After=network.target

[Service]
Type=simple
User=baan
Group=baan
WorkingDirectory=/opt/baan-marketplace
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
Environment=DATA_DIR=/var/lib/baan-marketplace
ExecStart=/usr/bin/node /opt/baan-marketplace/scripts/start.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/baan-marketplace
UMask=0077

[Install]
WantedBy=multi-user.target
